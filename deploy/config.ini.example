# /etc/plex-renamer/config.ini

[general]
# Comma-separated. Browsing is confined to these; nothing outside is reachable.
#
# Both roots are on the HOME nas. The condo nas holds its own copy of the KIKU
# library, but the two boxes sync it between themselves, so renaming the local
# copy is enough — and it keeps this tool off the WireGuard tunnel entirely.
roots    = /mnt/bama/volume1/TV Shows, /mnt/bama/volume1/Videos/KIKU
undo_dir = /var/lib/plex-renamer/undo

[server]
bind_host = 0.0.0.0
bind_port = 8101
